{
  "name": "secure-media-vault",
  "version": "1.0.0",
  "description": "Ultra-secure media downloader and vault",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "icons": "node scripts/generate-icons.js",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "build": {
    "appId": "com.secure.vault",
    "productName": "Secure Media Vault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@xenova/transformers": "^2.17.2",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "bip39": "^3.1.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "exiftool-vendored": "^37.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "p-queue": "^9.3.3",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-router-dom": "^7.18.2",
    "react-virtualized": "^9.22.6",
    "react-window": "^2.3.0",
    "sharp": "^0.35.4",
    "socks-proxy-agent": "^10.1.0",
    "sodium-native": "^5.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2",
    "yt-dlp-wrap": "^2.3.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-window": "^1.8.8",
    "@types/sodium-native": "^2.3.9",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "electron": "^44.0.0"
  },
  "author": "Secure Media Vault"
}